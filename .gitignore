# Bewusst minimal gehalten: dieses Repo soll den vollständigen Stand
# mitsamt Secrets, Keys und Caches aufnehmen.
# Einzige Ausnahme: node_modules/ (aktuell nicht vorhanden, nur Absicherung
# falls später npm install im omniroute/-Ordner läuft).
node_modules/

# Python-Laufzeitcaches aus Test-Läufen (pytest/Interpreter) — nicht
# versionieren. Die im Initial-Import committeten .pyc-Stände bleiben
# davon unberührt (gitignore greift nur für neue Dateien).
__pycache__/
*.pyc
